@model PeopleConnectApi.Models.Email.EmailConfirmationModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Verify Your Email</title>
</head>

<body style="margin:0; padding:0; background-color:#f4f6f8; font-family:Arial, Helvetica, sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
            <td align="center" style="padding:40px 15px;">

                <table width="600" cellpadding="0" cellspacing="0" border="0"
                       style="max-width:600px; width:100%; background-color:#ffffff; border-radius:8px;">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="padding:30px 20px 20px;">

                            <h1 style="margin:0; font-size:28px; color:#1f2937;">
                                PeopleConnect
                            </h1>

                            <p style="margin:8px 0 0; color:#6b7280; font-size:14px;">
                                Connect. Discover. Grow.
                            </p>

                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding:20px 40px 40px;">

                            <h2 style="margin:0 0 20px; color:#111827; font-size:22px;">
                                Hello @Model.FirstName,
                            </h2>

                            <p style="margin:0 0 15px; color:#4b5563; font-size:15px; line-height:1.6;">
                                Welcome to PeopleConnect!
                            </p>

                            <p style="margin:0 0 25px; color:#4b5563; font-size:15px; line-height:1.6;">
                                Please verify your email address to activate your account
                                and continue using PeopleConnect.
                            </p>

                            <!-- Verify Button -->
                            <table cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center" style="border-radius:6px; background-color:#2563eb;">

                                        <a href="@Model.ConfirmationLink"
                                               style="display:inline-block; padding:14px 28px;
                                            color:#ffffff; text-decoration:none;
                                            font-size:15px; font-weight:bold;">
                                            Verify Email
                                        </a>

                                    </td>
                                </tr>
                            </table>

                            <p style="margin:30px 0 10px; color:#6b7280; font-size:13px; line-height:1.5;">
                                If the button above does not work, copy and paste the following
                                link into your browser:
                            </p>

                            <p style="margin:0; word-break:break-all; font-size:12px;">
                                <a href="@Model.ConfirmationLink"
                                       style="color:#2563eb;">
                                    @Model.ConfirmationLink
                                </a>
                            </p>

                            <p style="margin:30px 0 0; color:#9ca3af; font-size:12px; line-height:1.5;">
                                If you did not create a PeopleConnect account, you can safely
                                ignore this email.
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center"
                            style="padding:20px; background-color:#f9fafb;">

                            <p style="margin:0; color:#9ca3af; font-size:12px;">
                                © 2026 PeopleConnect. All rights reserved.
                            </p>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>
</html>